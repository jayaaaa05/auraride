# Server Configuration
PORT=5000

# MongoDB Database Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/auraride?appName=Cluster0

# JSON Web Token Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Initial System Administrator Credentials
ADMIN_NAME=AuraRide System Admin
ADMIN_EMAIL=admin@auraride.in
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password_here
